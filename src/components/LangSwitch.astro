---
import { alternateLangPath } from '../i18n/utils';
import { useTranslations, type Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const alt = alternateLangPath(Astro.url);
---

<a
  href={alt.path}
  aria-label={t('lang.label')}
  class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-sm text-muted transition hover:border-accent hover:text-accent"
>
  <span aria-hidden="true">⇄</span>
  {t('lang.switch')}
</a>
