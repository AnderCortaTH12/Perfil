---
import { useTranslations, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-24">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-1 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <span>© {year} · {t('site.name')}</span>
    <span>{t('footer.built')}</span>
  </div>
</footer>
