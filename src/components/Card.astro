---
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  badge?: string;
  external?: boolean;
}
const { title, href, eyebrow, badge, external } = Astro.props;
const Tag = href ? 'a' : 'div';
const extra = href && external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
  href={href}
  {...extra}
  class:list={[
    'group flex h-full flex-col rounded-xl border border-line bg-white/50 p-6 transition',
    href ? 'hover:border-accent hover:shadow-sm hover:-translate-y-0.5' : '',
  ]}
>
  {eyebrow && <div class="mb-2 text-xs uppercase tracking-wider text-muted">{eyebrow}</div>}
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-xl leading-snug">{title}</h3>
    {
      badge && (
        <span class="shrink-0 rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
          {badge}
        </span>
      )
    }
  </div>
  <div class="mt-2 flex-1 text-sm leading-relaxed text-muted">
    <slot />
  </div>
  <slot name="footer" />
</Tag>
