---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import ForjaWidget from '../components/ForjaWidget.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'github'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const { Content } = await render(entry);
const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout lang={lang} title={d.titulo} description={d.descripcion}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <a
      href={localizedPath('/github', lang)}
      class="text-sm text-muted transition hover:text-accent">{t('list.back')}</a
    >

    <header class="mt-6 mb-8">
      <h1 class="font-serif text-4xl tracking-tight">{d.titulo}</h1>
      <p class="mt-4 text-lg text-muted">{d.descripcion}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
        {
          d.repo && (
            <a
              href={d.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4"
            >
              {t('meta.repo')} ↗
            </a>
          )
        }
        {
          d.demo && (
            <a
              href={d.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4"
            >
              {t('meta.demo')} ↗
            </a>
          )
        }
      </div>

      {
        (d.lenguaje || d.tags?.length > 0 || d.skills?.length > 0) && (
          <div class="mt-5 space-y-4">
            {d.lenguaje && (
              <div>
                <span class="text-xs uppercase tracking-wider text-muted">{t('meta.lenguaje')}</span>
                <p class="mt-2 text-sm font-medium">{d.lenguaje}</p>
              </div>
            )}
            {d.skills && d.skills.length > 0 && (
              <div>
                <span class="text-xs uppercase tracking-wider text-muted">{t('meta.stack')}</span>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {d.skills.map((skill) => (
                    <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">{skill}</li>
                  ))}
                </ul>
              </div>
            )}
            {d.tags && d.tags.length > 0 && (
              <div>
                <span class="text-xs uppercase tracking-wider text-muted">{t('meta.tags')}</span>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {d.tags.map((tag) => (
                    <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">#{tag}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }
    </header>

    {
      d.slug === 'forja-gimnasio' && (
        <section class="mt-10 px-6 flex justify-center">
          <ForjaWidget />
        </section>
      )
    }

    {
      d.capturas && d.capturas.length > 0 && (
        <section class="mt-10 space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            {d.capturas.map((captura) => (
              <figure class="overflow-hidden rounded-lg border border-line">
                <img
                  src={`${BASE_URL}${captura.src}`}
                  alt={captura.alt}
                  class="w-full"
                />
                {captura.alt && <figcaption class="px-3 py-2 text-sm text-muted">{captura.alt}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      entry.body && (
        <div class="prose-content mt-10">
          <Content />
        </div>
      )
    }

    {
      d.demo && (
        <div class="mt-12 flex justify-center">
          <a
            href={d.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg bg-accent px-6 py-3 font-medium text-white transition hover:opacity-90"
          >
            {t('meta.try')} ↗
          </a>
        </div>
      )
    }
  </article>
</Layout>
