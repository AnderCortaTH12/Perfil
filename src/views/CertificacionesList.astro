---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../i18n/utils';
import { getItems, formatDate } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('certificaciones', lang);
---

<Layout lang={lang} title={t('section.certificaciones')} description={t('desc.certificaciones')}>
  <PageIntro title={t('section.certificaciones')} description={t('desc.certificaciones')} />

  <section class="mx-auto max-w-3xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <ul class="grid gap-4 sm:grid-cols-2">
          {items.map((c) => (
            <li class="flex gap-4 rounded-xl border border-line bg-white/50 p-5">
              {c.data.logo && (
                <img
                  src={withBase(c.data.logo)}
                  alt=""
                  class="h-12 w-12 shrink-0 rounded-md object-contain"
                />
              )}
              <div class="min-w-0">
                <h2 class="font-serif text-lg leading-snug">{c.data.titulo}</h2>
                <p class="text-sm text-muted">{c.data.emisor}</p>
                <p class="text-xs text-muted">{formatDate(c.data.fecha, lang)}</p>
                <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                  {c.data.enlace_verificacion && (
                    <a
                      href={c.data.enlace_verificacion}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-accent underline underline-offset-2"
                    >
                      {t('meta.verify')} ↗
                    </a>
                  )}
                  {c.data.credencial_id && (
                    <span class="text-muted">
                      {t('meta.credential')}: {c.data.credencial_id}
                    </span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
