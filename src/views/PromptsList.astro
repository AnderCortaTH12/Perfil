---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import BoostButton from '../components/BoostButton.astro';
import TopBoosts from '../components/TopBoosts.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getItems } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('prompts', lang);

const labels = {
  es: { demo: 'Ver demo', github: 'Ver en GitHub', close: 'Cerrar' },
  en: { demo: 'View demo', github: 'View on GitHub', close: 'Close' },
}[lang];
---

<Layout lang={lang} title={t('section.prompts')} description={t('desc.prompts')}>
  <PageIntro title={t('section.prompts')} description={t('desc.prompts')} />

  <TopBoosts lang={lang} section="prompts" />

  <section class="mx-auto max-w-5xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <div class="grid gap-5 md:grid-cols-2">
          {items.map((p) => (
            <div
              class="relative flex flex-col"
              data-boost-card
              data-slug={p.data.slug}
              data-section="prompts"
              data-title={p.data.titulo}
            >
              <article class="flex flex-col rounded-xl border border-line bg-white/50 p-6">
                {p.data.categoria && (
                  <span class="text-xs uppercase tracking-wider text-accent">
                    {p.data.categoria}
                  </span>
                )}
                <h2 class="mt-1 font-serif text-xl">{p.data.titulo}</h2>
                <p class="mt-2 text-sm text-muted">{p.data.descripcion}</p>

                {p.data.tags.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {p.data.tags.map((tag) => (
                      <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">
                        #{tag}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="mt-5 flex flex-wrap gap-3 pt-1">
                  {p.data.demo && (
                    <button
                      type="button"
                      class="demo-trigger rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-white transition hover:opacity-90"
                      data-demo={p.data.demo}
                    >
                      {labels.demo}
                    </button>
                  )}
                  {p.data.github && (
                    <a
                      href={p.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full border border-line px-4 py-1.5 text-sm font-medium text-muted transition hover:text-accent"
                    >
                      {labels.github}
                    </a>
                  )}
                </div>
              </article>
              <div class="mt-2 flex justify-end">
                <BoostButton lang={lang} slug={p.data.slug} section="prompts" />
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <!-- Modal fullscreen para la demo -->
  <div
    id="demo-modal"
    class="hidden"
    style="position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.95);"
  >
    <button
      type="button"
      id="demo-close"
      aria-label={labels.close}
      style="position: absolute; top: 16px; right: 20px; color: #fff; font-size: 28px; cursor: pointer; background: none; border: none; line-height: 1; z-index: 1;"
    >×</button>
    <iframe
      id="demo-frame"
      title={labels.demo}
      style="width: 100%; height: 100%; border: none;"
    ></iframe>
  </div>
</Layout>

<script>
  const modal = document.getElementById('demo-modal');
  const frame = document.getElementById('demo-frame') as HTMLIFrameElement | null;
  const closeBtn = document.getElementById('demo-close');

  function openModal(src: string) {
    if (!modal || !frame) return;
    frame.src = src;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal || !frame) return;
    modal.classList.add('hidden');
    frame.src = 'about:blank';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.demo-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.demo;
      if (src) openModal(src);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
