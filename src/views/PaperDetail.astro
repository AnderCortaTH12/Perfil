---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { formatDate } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'papers'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
---

<Layout lang={lang} title={d.titulo} description={d.abstract}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <a
      href={localizedPath('/papers', lang)}
      class="text-sm text-muted transition hover:text-accent">{t('list.back')}</a
    >

    <header class="mt-6 mb-8">
      <p class="text-sm text-muted">{formatDate(d.fecha, lang)}</p>
      <h1 class="mt-2 font-serif text-4xl tracking-tight">{d.titulo}</h1>
      {d.autores.length > 0 && <p class="mt-2 text-muted">{d.autores.join(', ')}</p>}
      {d.publicacion && <p class="mt-1 text-sm italic text-muted">{d.publicacion}</p>}

      <div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
        {
          d.pdf && (
            <a
              href={d.pdf}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-md bg-ink px-3 py-1.5 text-paper transition hover:bg-accent"
            >
              {t('meta.pdf')}
            </a>
          )
        }
        {
          d.enlace && (
            <a
              href={d.enlace}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent underline underline-offset-4"
            >
              {t('meta.link')} ↗
            </a>
          )
        }
      </div>
    </header>

    <div class="prose-content">
      <h2 class="font-serif text-lg">Abstract</h2>
      <p>{d.abstract}</p>
      <Content />
    </div>
  </article>
</Layout>
