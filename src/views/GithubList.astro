---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import BoostButton from '../components/BoostButton.astro';
import TopBoosts from '../components/TopBoosts.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getItems } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('github', lang);
---

<Layout lang={lang} title={t('section.github')} description={t('desc.github')}>
  <PageIntro title={t('section.github')} description={t('desc.github')} />

  <TopBoosts lang={lang} section="github" />

  <section class="mx-auto max-w-5xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <div class="grid gap-5 md:grid-cols-2">
          {items.map((r) => (
            <div
              class="relative flex flex-col"
              data-boost-card
              data-slug={r.data.slug}
              data-section="github"
              data-title={r.data.titulo}
            >
              <article class="flex h-full flex-col rounded-xl border border-line bg-white/50 p-6">
                {r.data.lenguaje && (
                  <div class="mb-2 text-xs uppercase tracking-wider text-muted">
                    {r.data.lenguaje}
                  </div>
                )}
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-serif text-xl leading-snug">
                    {r.data.repo ? (
                      <a
                        href={r.data.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition hover:text-accent"
                      >
                        {r.data.titulo}
                      </a>
                    ) : (
                      r.data.titulo
                    )}
                  </h3>
                  {r.data.destacado && (
                    <span class="shrink-0 rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
                      {t('card.featured')}
                    </span>
                  )}
                </div>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{r.data.descripcion}</p>
                {r.data.tags.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {r.data.tags.map((tag) => (
                      <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">
                        #{tag}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-4 flex justify-end">
                  <BoostButton lang={lang} slug={r.data.slug} section="github" />
                </div>
              </article>
            </div>
          ))}
        </div>
      )
    }
  </section>
</Layout>
