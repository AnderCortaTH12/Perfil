---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Card from '../components/Card.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getItems } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('github', lang);
---

<Layout lang={lang} title={t('section.github')} description={t('desc.github')}>
  <PageIntro title={t('section.github')} description={t('desc.github')} />

  <section class="mx-auto max-w-5xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <div class="grid gap-5 md:grid-cols-2">
          {items.map((r) => (
            <Card
              title={r.data.titulo}
              href={r.data.repo || undefined}
              external
              eyebrow={r.data.lenguaje}
              badge={r.data.destacado ? t('card.featured') : undefined}
            >
              <p>{r.data.descripcion}</p>
              {r.data.tags.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-1.5" slot="footer">
                  {r.data.tags.map((tag) => (
                    <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">
                      #{tag}
                    </li>
                  ))}
                </ul>
              )}
            </Card>
          ))}
        </div>
      )
    }
  </section>
</Layout>
