---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import BoostButton from '../components/BoostButton.astro';
import TopBoosts from '../components/TopBoosts.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { getItems, formatDate, isNew } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('divulgacion', lang);
---

<Layout lang={lang} title={t('section.divulgacion')} description={t('desc.divulgacion')}>
  <PageIntro title={t('section.divulgacion')} description={t('desc.divulgacion')} />

  <TopBoosts lang={lang} section="divulgacion" narrow />

  <section class="mx-auto max-w-3xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <ul class="divide-y divide-line">
          {items.map((a) => (
            <li
              class="relative py-7 first:pt-0"
              data-boost-card
              data-slug={a.data.slug}
              data-section="divulgacion"
              data-title={a.data.titulo}
            >
              <a href={localizedPath('/divulgacion/' + a.data.slug, lang)} class="group block">
                <p class="flex items-center gap-2 text-sm text-muted">
                  {formatDate(a.data.fecha, lang)}
                  {isNew(a.data.fecha) && (
                    <span class="rounded-full bg-ink px-2 py-0.5 text-xs font-medium text-paper">
                      {t('card.new')}
                    </span>
                  )}
                </p>
                <h2 class="mt-1 font-serif text-2xl leading-snug transition group-hover:text-accent">
                  {a.data.titulo}
                </h2>
                <p class="mt-3 text-muted">{a.data.resumen}</p>
                {a.data.tags.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-1.5">
                    {a.data.tags.map((tag) => (
                      <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">
                        #{tag}
                      </li>
                    ))}
                  </ul>
                )}
              </a>
              <div class="mt-3 flex justify-end">
                <BoostButton lang={lang} slug={a.data.slug} section="divulgacion" />
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
