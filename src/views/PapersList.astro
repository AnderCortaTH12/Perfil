---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { getItems, formatDate } from '../lib/content';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const items = await getItems('papers', lang);
---

<Layout lang={lang} title={t('section.papers')} description={t('desc.papers')}>
  <PageIntro title={t('section.papers')} description={t('desc.papers')} />

  <section class="mx-auto max-w-3xl px-6 pb-16">
    {
      items.length === 0 ? (
        <p class="text-muted">{t('list.empty')}</p>
      ) : (
        <ul class="divide-y divide-line">
          {items.map((p) => (
            <li class="py-7 first:pt-0">
              <a
                href={localizedPath('/papers/' + p.data.slug, lang)}
                class="group block"
              >
                <p class="text-sm text-muted">{formatDate(p.data.fecha, lang)}</p>
                <h2 class="mt-1 font-serif text-2xl leading-snug transition group-hover:text-accent">
                  {p.data.titulo}
                </h2>
                {p.data.autores.length > 0 && (
                  <p class="mt-1 text-sm text-muted">{p.data.autores.join(', ')}</p>
                )}
                <p class="mt-3 text-muted">{p.data.abstract}</p>
                {p.data.publicacion && (
                  <p class="mt-2 text-sm italic text-muted">{p.data.publicacion}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Layout>
