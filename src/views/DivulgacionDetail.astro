---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';
import { formatDate } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'divulgacion'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;
---

<Layout lang={lang} title={d.titulo} description={d.resumen}>
  <article class="mx-auto max-w-3xl px-6 pt-16 pb-12">
    <a
      href={localizedPath('/divulgacion', lang)}
      class="text-sm text-muted transition hover:text-accent">{t('list.back')}</a
    >

    <header class="mt-6 mb-8">
      <p class="text-sm text-muted">{formatDate(d.fecha, lang)}</p>
      <h1 class="mt-2 font-serif text-4xl leading-tight tracking-tight">{d.titulo}</h1>
      <p class="mt-4 text-lg text-muted">{d.resumen}</p>
      {
        d.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {d.tags.map((tag) => (
              <li class="rounded-full bg-paper-soft px-2.5 py-0.5 text-xs text-muted">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      d.imagen && (
        <img
          src={d.imagen}
          alt={d.titulo}
          class="mb-8 w-full rounded-lg border border-line"
        />
      )
    }

    <div class="prose-content">
      <Content />
    </div>
  </article>
</Layout>
